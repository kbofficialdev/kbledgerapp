datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  OPERATOR
}

enum PaymentType {
  CREDIT       // Unpaid Udhaar
  DEBIT        // Full payment paid
  PARTIAL      // Partial paid + partial credit
}

enum PaymentMethod {
  CASH
  CASHFREE_ELEMENTS
  CASHFREE_UPI
  CASHFREE_CARD
  CASHFREE_NETBANKING
  GOOGLE_PAY_UPI
  GOOGLE_PAY_QR
  UPI_INTENT
  NETBANKING
  MANUAL_TRANSFER
  CASHFREE_PG
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum LedgerType {
  BILL_DEBIT      // Bill charged to customer
  PAYMENT_CREDIT  // Cash/Gateway received from customer (Jama)
  ADJUSTMENT
}

model Village {
  id          String     @id @default(cuid())
  code        String     @unique // e.g. "VIL-001"
  name        String
  taluk       String?
  district    String?
  pincode     String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customers   Customer[]
  orders      Order[]

  @@index([name])
  @@index([code])
}

model Customer {
  id              String        @id @default(cuid())
  customerCode    String        @unique // e.g. "CUST-RAM-001"
  name            String
  mobile          String        @unique
  altMobile       String?
  email           String?       @unique
  address         String?
  villageId       String
  village         Village       @relation(fields: [villageId], references: [id], onDelete: Restrict)
  creditLimit     Decimal       @default(0.00) @db.Decimal(12, 2)
  currentBalance  Decimal       @default(0.00) @db.Decimal(12, 2) // Outstanding Udhaar owed
  notes           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders          Order[]
  payments        Payment[]
  ledgerEntries   LedgerEntry[]
  transactions    TransactionAudit[]
  supportTickets  SupportTicket[]

  @@index([villageId, name])
  @@index([mobile])
  @@index([email])
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique // e.g. "KB-202610-0001"
  villageId           String
  village             Village       @relation(fields: [villageId], references: [id], onDelete: Restrict)
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  orderDate           DateTime      @default(now())
  totalAmount         Decimal       @db.Decimal(12, 2)
  paidAmount          Decimal       @default(0.00) @db.Decimal(12, 2)
  creditAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  paymentType         PaymentType
  paymentStatus       PaymentStatus @default(SUCCESS)
  
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  items               OrderItem[]
  payments            Payment[]
  ledgerEntries       LedgerEntry[]

  @@index([customerId, orderDate])
  @@index([villageId, orderDate])
  @@index([paymentType])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  customItemId  String    // Unique customized item code generated at creation (e.g. "ITM-98421")
  name          String
  quantity      Decimal   @db.Decimal(10, 3)
  unit          String    @default("pcs") // kg, bag, pkt, liter, pcs, box
  pricePerUnit  Decimal   @db.Decimal(10, 2)
  lineTotal     Decimal   @db.Decimal(12, 2)

  @@index([orderId])
  @@index([customItemId])
}

model Payment {
  id                  String         @id @default(cuid())
  paymentRef          String         @unique
  orderId             String?
  order               Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId          String
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  amount              Decimal        @db.Decimal(12, 2)
  method              PaymentMethod  @default(CASH)
  status              PaymentStatus  @default(SUCCESS)
  
  // Cashfree Payments Gateway Transaction Fields
  cashfreeOrderId      String?        @unique // Cashfree Order Identifier (e.g. order_1234567)
  cashfreePaymentId    String?        @unique // Cashfree Payment Reference (cf_payment_id)
  paymentSessionId     String?        // Cashfree Payment Session ID for Custom Web Checkout Elements
  
  // Legacy / UPI Reference Fields
  merchantTxnId       String?        @unique
  gpayTransactionId   String?        @unique
  upiRefId            String?        @unique
  bankRrn             String?        // 12-digit Bank Retrieval Reference Number
  payerVpa            String?        // Payer UPI Virtual Payment Address
  gatewayResponseCode String?        // SUCCESS, FAILED, etc.
  rawGatewayResponse  Json?
  
  paidAt              DateTime       @default(now())
  notes               String?

  @@index([customerId, paidAt])
  @@index([cashfreeOrderId])
  @@index([cashfreePaymentId])
  @@index([merchantTxnId])
}

model LedgerEntry {
  id              String      @id @default(cuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  entryDate       DateTime    @default(now())
  entryType       LedgerType
  debitAmount     Decimal     @default(0.00) @db.Decimal(12, 2)  // Bill added
  creditAmount    Decimal     @default(0.00) @db.Decimal(12, 2) // Payment received
  runningBalance  Decimal     @db.Decimal(12, 2)                // Cumulative outstanding
  description     String
  
  createdAt       DateTime    @default(now())

  @@index([customerId, entryDate])
}

model AdminProfile {
  id              String      @id @default(cuid())
  username        String      @unique
  email           String?     @unique
  mobile          String?     @unique
  role            Role        @default(ADMIN)
  isFaceEnrolled  Boolean     @default(false)
  
  faceDescriptor  Json?       // Multi-frame calibrated 128-d biometric facial vector
  fallbackPinHash String?
  
  failedAttempts  Int         @default(0)
  lockedUntil     DateTime?
  
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SystemAuditLog {
  id          String    @id @default(cuid())
  actor       String
  action      String    // e.g. "GPAY_PAYMENT_VERIFIED", "FACE_LOGIN_SUCCESS", "SECURITY_POLICY_ENFORCED"
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
}

model AssistantConversation {
  id        String             @id @default(cuid())
  title     String             @default("New Conversation")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  @@index([updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String                // "user" | "assistant"
  content        String                @db.Text
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageSenderRole {
  CUSTOMER
  ADMIN
  SYSTEM
}

model ActiveSession {
  id               String    @id @default(cuid())
  identifier       String    // Customer ID or Admin username
  role             String    // "ADMIN" | "CUSTOMER"
  ipAddress        String    // Client IP Address
  userAgent        String?
  tokenHash        String    @unique // SHA-256 of session token
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([identifier, role, isActive])
  @@index([ipAddress])
}

model TransactionAudit {
  id                String         @id @default(cuid())
  transactionRef    String         @unique // e.g. "TXN-202610-10492"
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  amount            Decimal        @db.Decimal(12, 2)
  method            PaymentMethod  @default(CASHFREE_ELEMENTS)
  status            PaymentStatus  @default(SUCCESS)
  
  // Ledger balance snapshots for complete mathematical proof
  balanceBefore     Decimal        @db.Decimal(12, 2)
  balanceAfter      Decimal        @db.Decimal(12, 2)
  
  // Multi-order allocation breakdown in JSON
  // Array of { orderId, orderNumber, amountAllocated, previousCredit, remainingCredit }
  orderAllocations  Json?
  
  // Gateway references
  cashfreeOrderId   String?
  cashfreePaymentId String?
  paymentSessionId  String?
  
  ipAddress         String?
  userAgent         String?
  notes             String?
  createdAt         DateTime       @default(now())

  @@index([customerId, createdAt])
  @@index([cashfreeOrderId])
  @@index([transactionRef])
}

model SupportTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique // e.g. "TKT-202610-001"
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  subject       String
  category      String          // "BILLING", "LEDGER_DISCREPANCY", "PAYMENT_ISSUE", "GENERAL"
  priority      TicketPriority  @default(MEDIUM)
  status        TicketStatus    @default(OPEN)
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      TicketMessage[]

  @@index([customerId, status])
  @@index([status, priority])
}

model TicketMessage {
  id            String            @id @default(cuid())
  ticketId      String
  ticket        SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderRole    MessageSenderRole
  senderName    String
  content       String            @db.Text
  attachments   Json?
  
  createdAt     DateTime          @default(now())

  @@index([ticketId, createdAt])
}


